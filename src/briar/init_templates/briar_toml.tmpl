# .briar.toml — briar project config
# Resolution precedence: CLI flag > env var > this file > built-in default.
# Docs: https://usebriar.com/docs/configuration

company = "@@COMPANY@@"

# Telemetry is off. Uncomment to send error reports ("full" also sends usage counts):
# telemetry = "errors-only"

[repo]
owner = "@@OWNER@@"
repo  = "@@REPO@@"
provider = "github"

# Extractor settings for `briar extract` (every key: `briar extract -h`,
# or agents/extract.md). Uncomment to use: one value for every extractor,
# then values for one of them.
# [extract]
# max = 50
# [extract.active-tickets]
# projects = ["ACME"]
